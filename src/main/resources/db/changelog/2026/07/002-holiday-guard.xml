<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- BOOTSTRAP-ORDER GUARD: dcre-hcs owns public_holiday (single writer, R-04),
         but CDE is launched per arrival and may run before HCS's first 6h clock
         window ever executed on a fresh DB, so the read-only source is created
         here IF NOT EXISTS with the owner's EXACT column set (dcre-hcs
         001-hcs.xml). The owner's own changelog creates the same DDL
         IF NOT EXISTS; per-service liquibase history tables make this safe. -->
    <changeSet id="002-public-holiday-guard-cde" author="dcre">
        <sql>
            CREATE TABLE IF NOT EXISTS public_holiday (
                id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
                country VARCHAR(2) NOT NULL,
                holiday_date DATE NOT NULL,
                local_name VARCHAR(128),
                name VARCHAR(128),
                is_global BOOL,
                version BIGINT NOT NULL DEFAULT 0,
                created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
                updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
                UNIQUE (country, holiday_date)
            );
        </sql>
    </changeSet>

</databaseChangeLog>
